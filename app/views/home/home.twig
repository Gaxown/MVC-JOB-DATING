<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouCode Job Dating - Offres d'Emploi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
    <!-- Include Header -->
    {% include 'tools/header.twig' %}

    
    
    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
    
        <h1 class="text-3xl font-bold mb-8 text-center">Offres d'Emploi</h1>
        <!-- Search Form -->
        <div class="flex items-center justify-center mb-6">
            <input type="text" id="search" placeholder="Rechercher des offres d'emploi..." class="w-64 p-2 border border-gray-300 rounded">
        </div>

        <!-- Search Results -->
        <div id="search-results" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Job Offers will be displayed here -->
        </div>

        <!-- Job Offers -->
        <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-6" id="job-offers">
            <!-- Job Offer 1 -->
            {% for announcement in announcements %}
            <div class="bg-white shadow-md rounded-lg overflow-hidden job-offer w-80 h-auto">
                <img src="{{ announcement.cover }}" alt="Company Logo" class="w-full h-48 object-cover">
                <div class="p-6">
                    <h2 class="text-xl font-semibold mb-2">{{ announcement.title }}</h2>
                    <p class="text-gray-600 mb-4">{{ announcement.getCompany().name }}</p>
                    <p class="text-gray-700 mb-4">{{ announcement.description|split(' ')|slice(0, 4)|join(' ') ~ '...'}}</p>
                    <p class="text-sm text-gray-500">Candidatures: {{ announcement.candidates_count }}</p>
                    <p class="text-sm text-gray-500">Publié le: {{ announcement.created_at|date('d M Y') }}</p>
                    <form action="/admin/announcements/details/{{ announcement.id }}" method="GET">
                   
                        <button class="mt-4 w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600 transition">Consulter les details</button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    </main>

    <!-- Include Footer -->
    {% include 'tools/footer.twig' %}
<script>
    $(document).ready(function() {
        let searchTimeout;
        
        $("#search").on("keyup", function() {
            clearTimeout(searchTimeout);
            const searchValue = $(this).val();
            
            // Attendre 500ms après la dernière frappe avant d'envoyer la requête
            searchTimeout = setTimeout(function() {
                $.ajax({
                    url: '/search-announcements',
                    method: 'POST',
                    data: { query: searchValue },
                    success: function(response) {
                        $('#job-offers').empty();
                        
                        if (response.announcements && response.announcements.length > 0) {
                            response.announcements.forEach(function(announcement) {
                                const jobOffer = `
                                    <div class="bg-white shadow-md rounded-lg overflow-hidden job-offer w-80 h-auto">
                                        <img src="${announcement.cover}" alt="Company Logo" class="w-full h-48 object-cover">
                                        <div class="p-6">
                                            <h2 class="text-xl font-semibold mb-2">${announcement.title}</h2>
                                            <p class="text-gray-600 mb-4">${announcement.company_name}</p>
                                            <p class="text-gray-700 mb-4">${announcement.description}</p>
                                            <p class="text-sm text-gray-500">Candidatures: ${announcement.candidates_count}</p>
                                            <p class="text-sm text-gray-500">Publié le: ${announcement.created_at}</p>
                                            <form action="/admin/announcements/details/${announcement.id}" method="GET">
                                                <button class="mt-4 w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600 transition">Consulter les details</button>
                                            </form>
                                        </div>
                                    </div>
                                `;
                                $('#job-offers').append(jobOffer);
                            });
                        } else {
                            $('#job-offers').html('<p class="text-center text-gray-500">Aucune annonce trouvée</p>');
                        }
                    },
                    error: function() {
                        $('#job-offers').html('<p class="text-center text-red-500">Une erreur est survenue lors de la recherche</p>');
                    }
                });
            }, 500);
        });
    });
</script>
     
</body>
</html>