<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détails de l'Offre d'Emploi</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <!-- Include Header -->
    {% include 'tools/header.twig' %}

        <form action="/" method="GET">
            <button class="ml-6 mt-6"><i class="fas fa-arrow-circle-left text-blue-500 hover:text-blue-300 fa-lg"></i></button>  
        </form>
    
    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-8 text-center">{{ announcement.title }}</h1>
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <img src="{{ announcement.getCompany().cover }}" alt="Company Cover" class="w-full h-48 object-cover">
        <div class="ml-2 mt-4">
            <img src="{{ announcement.getCompany().logo }}" alt="Company Logo" class="h-16 w-16 object-cover rounded-full">
        </div>

        <div class="p-6">
            <p class="text-gray-700 mb-4">{{ announcement.description }}</p>
            <p class="text-sm text-gray-500">Publié le: {{ announcement.created_at|date('d M Y') }}</p>
            <p class="text-sm text-gray-500">Candidatures: {{ announcement.candidates_count }}</p>
            <div class="mt-4">
                <h3 class="text-lg font-semibold">Informations sur l'entreprise</h3>
                <p class="text-gray-600">Offre créée par entreprise :: {{ announcement.getCompany().name }}</p>
                <p class="text-gray-600">Adresse: {{ announcement.getCompany().location }}</p>
                <p class="text-gray-600">Site web: <a href="{{ announcement.getCompany().website }}" class="text-blue-500">{{ announcement.getCompany().website }}</a></p>
            </div>
        </div>
    </div>
    </main>

    <!-- Include Footer -->
    {% include 'tools/footer.twig' %}
</body>
</html>