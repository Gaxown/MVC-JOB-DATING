/companies.twig
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Companies Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
</head>
<body class="bg-gray-100">
    <!-- Sidebar -->
    {% include 'tools/sidebar_admin.twig' %}

    <!-- Main Content -->
    <div class="ml-64 p-8">
        <div class="bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200 flex justify-between items-center">
                <h2 class="text-xl font-semibold">Companies Management</h2>
                <a href="/admin/companies/create" class=" h-10 block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                            <i class='bx bx-edit mr-1'></i>add company
                        </a>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 gap-6">
                    {% for company in companies %}
                    <div class="border rounded-lg p-6 flex space-x-6">
                        <div class="w-48 h-48 flex-shrink-0">
                            <img src="{{ company.logo }}" alt="{{ company.name }}" class="w-full h-full object-cover rounded-lg">
                        </div>
                        <div class="flex-grow">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <h3 class="text-xl font-semibold mb-2">{{ company.name }}</h3>
                                    <p class="text-gray-600 mb-2">{{ company.description }}</p>
                                    <p class="text-sm text-blue-500 mb-2">
                                        <a href="{{ company.website }}" target="_blank">
                                            <i class='bx bx-link-external mr-1'></i>Website
                                        </a>
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-600 mb-2">
                                        <i class='bx bx-map mr-1'></i>
                                        <span class="font-medium">Location:</span> {{ company.location }}
                                    </p>
                                    <p class="text-sm text-gray-600 mb-2">
                                        <i class='bx bx-group mr-1'></i>
                                        <span class="font-medium">Effective:</span> {{ company.effective }}
                                    </p>
                                    <p class="text-sm text-gray-600 mb-2">
                                        <i class='bx bx-dollar-circle mr-1'></i>
                                        <span class="font-medium">Capital:</span> {{ company.capital }}
                                    </p>
                                </div>
                            </div>
                            <div class="mt-4">
                                <h4 class="font-medium mb-2">Services:</h4>
                                <p class="text-gray-600">{{ company.service}}</p>
                            </div>
                              <div class="mt-4 flex space-x-4">
                        {# <a href="/admin/companies/edit/{{ company.id }}" class=" h-10 block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                            <i class='bx bx-edit mr-1'></i>Update
                        </a> #}

                        <form action="/admin/companies/update/{{ company.id }}" method="get" >
                            <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                                <i class='bx bx-edit mr-1'></i>Update
                            </button>
                        </form>

                        <form action="/admin/companies/delete/{{ company.id }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this company?');">
                            <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
                                <i class='bx bx-trash mr-1'></i>Delete
                            </button>
                        </form>
                    </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {# foor test => #}
                <div class="grid grid-cols-1 gap-6">
                <div class="border rounded-lg p-6 flex space-x-6">
                    <div class="w-48 h-48 flex-shrink-0">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTgsRHYMqosY4O_9Ihm56igS8cKbNHtUCk6GA&s" alt="TechNova Solutions" class="w-full h-full object-cover rounded-lg">
                    </div>
                    <div class="flex-grow">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <h3 class="text-xl font-semibold mb-2">TechNova Solutions</h3>
                                <p class="text-gray-600 mb-2">Innovative IT solutions for modern businesses.</p>
                                <p class="text-sm text-blue-500 mb-2">
                                    <a href="https://technova.com" target="_blank">
                                        <i class='bx bx-link-external mr-1'></i>Website
                                    </a>
                                </p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600 mb-2">
                                    <i class='bx bx-map mr-1'></i>
                                    <span class="font-medium">Location:</span> San Francisco, CA
                                </p>
                                <p class="text-sm text-gray-600 mb-2">
                                    <i class='bx bx-group mr-1'></i>
                                    <span class="font-medium">Effective:</span> 500+ employees
                                </p>
                                <p class="text-sm text-gray-600 mb-2">
                                    <i class='bx bx-dollar-circle mr-1'></i>
                                    <span class="font-medium">Capital:</span> $50M
                                </p>
                            </div>
                        </div>
                        <div class="mt-4">
                            <h4 class="font-medium mb-2">Services:</h4>
                            <p class="text-gray-600">Web Development, Cloud Computing, AI Solutions</p>
                        </div>
                         <div class="mt-4 flex space-x-4">
                        <a href="/admin/companies/{{ company.id }}/edit" class=" h-10 block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                            <i class='bx bx-edit mr-1'></i>Update
                        </a>
                        <form action="/admin/companies/{{ company.id }}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this company?');">
                            <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
                                <i class='bx bx-trash mr-1'></i>Delete
                            </button>
                        </form>
                    </div>
                    </div>
                   
                </div>

                


            </div>
        </div>
    </div>
</body>
</html>