=/app/views/admin/offers.twig
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Offers Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
</head>
<body class="bg-gray-100">
    <!-- Sidebar -->
{% include 'tools/sidebar_admin.twig' %}

    <!-- Main Content -->
    <div class="ml-64 p-8">
    <div class="bg-white rounded-lg shadow">
        <div class="p-6 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-xl font-semibold">Job Offers Management</h2>
            <a href="/admin/announcements/create" class="px-4 py-2 bg-blue-600 text-white rounded-lg shadow-md hover:bg-blue-700 transition">
                <i class='bx bx-plus mr-2'></i>Add New Offer
            </a>
        </div>
        <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                
                <!-- Fake Job Offer 1 -->
            {% for announcement in announcements %}
            <div class="bg-white shadow-md rounded-lg overflow-hidden job-offer w-80 h-auto">
                <img src="{{ announcement.cover }}" alt="Announce Cover" class="w-full h-48 object-cover">
                <div class="p-6">
                    <h2 class="text-xl font-semibold mb-2">{{ announcement.title }}</h2>
                    <p class="text-gray-600 mb-4">{{ announcement.getCompany().name }}</p>
                    <p class="text-gray-700 mb-4">{{ announcement.description|split(' ')|slice(0, 4)|join(' ') ~ '...'}}</p>
                    <p class="text-sm text-gray-500">Candidatures: {{ announcement.candidates_count }}</p>
                    <p class="text-sm text-gray-500">Publié le: {{ announcement.created_at|date('d M Y') }}</p>
                    <div class="flex justify-center gap-16 items-center mt-4">
                        <form action="/admin/announcements/delete/{{ announcement.id }}" method="GET">
                            <button class=" w-20 bg-red-600 text-white py-2 rounded hover:bg-red-500 transition"><i class="fas fa-trash-alt text-white"></i> Delete</button>
                        </form>
                        <form action="/admin/announcements/update/{{ announcement.id }}" method="GET">
                        <button class=" w-24 bg-orange-500 text-white py-2 rounded hover:bg-orange-600 transition"><i class="fas fa-edit text-white"></i>Update</button>
                        </form>
                    </div>
                </div>
        </div>
            {% endfor %}





            </div>
        </div>
    </div>
</div>

</body>
</html>