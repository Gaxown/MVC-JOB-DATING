/dashbord.twig
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>

</head>
<body class="bg-gray-100">
    <!-- Header -->

    <!-- Sidebar -->
    
<!-- Change this line -->
{% include 'tools/sidebar_admin.twig' %}

    <!-- Main Content -->
    <div class="ml-64 p-8">
        <!-- Stats Cards -->
        <div class="grid sm:grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">Total Users</p>
                        <h3 class="text-2xl font-bold">{{ users_count }} </h3>
                    </div>
                    <i class='bx bx-user text-3xl text-blue-500'></i>
                </div>
                <a href="users" class="text-blue-500 text-sm mt-4 inline-block hover:underline">View all users</a>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">Total Companies</p>
                        <h3 class="text-2xl font-bold">{{ companies_count }}</h3>
                    </div>
                    <i class='bx bx-building text-3xl text-green-500'></i>
                </div>
                <a href="/admin/companies" class="text-blue-500 text-sm mt-4 inline-block hover:underline">View all companies</a>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">Total Offers</p>
                        <h3 class="text-2xl font-bold">{{ offers_count }}</h3>
                    </div>
                    <i class='bx bx-briefcase text-3xl text-orange-500'></i>
                </div>
                <a href="announcements" class="text-blue-500 text-sm mt-4 inline-block hover:underline">View all offers</a>
            </div>
        </div>
    </div>
</body>
</html>