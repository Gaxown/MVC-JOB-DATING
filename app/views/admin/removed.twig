<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Offers Removed</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
</head>
<body class="bg-gray-100">
    <!-- Sidebar -->
    {% include 'tools/sidebar_admin.twig' %}

    <!-- Main Content -->
    <div class="ml-64 p-8">
        <div class="bg-white rounded-lg shadow">
            <div class="p-6 border-b border-gray-200">
                <h2 class="text-xl font-semibold">Removed Offers</h2>
            </div>
            <div class="p-6">
                <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for announcement in announcements %}
                    <div class="bg-gray-200 shadow-md rounded-lg overflow-hidden job-offer w-80 h-auto opacity-75">
                        <img src="{{ announcement.cover }}" alt="Company Logo" class="w-full h-48 object-cover">
                        <div class="p-6">
                            <h2 class="text-xl font-semibold mb-2">{{ announcement.title }}</h2>
                            <p class="text-gray-600 mb-4">{{ announcement.getCompany().name }}</p>
                            <p class="text-gray-700 mb-4">{{ announcement.description|split(' ')|slice(0, 4)|join(' ') ~ '...'}}</p>
                            <p class="text-sm text-gray-500">Candidatures: {{ announcement.candidates_count }}</p>
                            <p class="text-sm text-gray-500">Publié le: {{ announcement.created_at|date('d M Y') }}</p>
                            <form action="/admin/announcements/restore/{{ announcement.id }}" method="POST">
                                <button class=" mt-4 w-16 bg-green-600 text-white py-2 rounded hover:bg-green-500 transition">Restore</button>
                            </form>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</body>
</html>
